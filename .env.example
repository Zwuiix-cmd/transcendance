# Shared local configuration. Copy to .env before running Docker Compose.
API_KEY=replace-with-a-long-random-api-key
DATABASE_PATH=/app/data/transcendance.db
SESSION_TTL=PT24H
CORS_ALLOWED_ORIGINS=https://localhost
SITE_ADDRESS=localhost
API_BIND_ADDRESS=127.0.0.1
API_PORT=8080
HTTP_PORT=80
HTTPS_PORT=443

# Used only to bootstrap the first admin role. Further role changes are persisted from the admin panel.
ADMIN_USERNAMES=admin
ADMIN_EMAILS=

# Internal Go REST API-to-Go file CDN connection. The API owns matchmaking directly.
CDN_URL=http://cdn:8091
CDN_PUBLIC_URL=/files
REDIS_URL=redis://redis:6379/0
INTERNAL_CDN_API_KEY=replace-with-a-long-random-cdn-key
GAME_SERVICE_KEY=replace-with-a-long-random-game-service-key

# Keep true behind the HTTPS Caddy entrypoint. Use false only for direct local HTTP PHP runs.
ADMIN_COOKIE_SECURE=true

# Explicit local-only debug bypass. Keep all of these false/empty outside development.
DEBUG_AUTH_ENABLED=false
DEBUG_AUTH_USERNAME=Zwuiix
VITE_DEBUG_AUTH=false

# Only used when building the web image with a separate static-assets origin.
VITE_ASSET_BASE_URL=/

# Optional backend OpenTelemetry JSON traces for local diagnostics.
OTEL_TRACES_STDOUT=false
