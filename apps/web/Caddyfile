{
    auto_https disable_redirects
}

{$SITE_ADDRESS}:80 {
    redir https://{$SITE_ADDRESS}:1443{uri} permanent
}

{$SITE_ADDRESS}:443 {
    tls internal
    encode gzip

    @versionedAssets path /assets/*
    header @versionedAssets Cache-Control "public, max-age=31536000, immutable"
    @brandAsset path /uno.svg
    header @brandAsset Cache-Control "public, max-age=86400"
    @adminAssets path /admin/admin.css /admin/admin.js
    header @adminAssets Cache-Control "public, max-age=86400"

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
    }

    @topLevelPages {
        not path /files/uno/index.html
    }
    header @topLevelPages {
        X-Frame-Options "DENY"
        Content-Security-Policy "default-src 'self'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://cdn.discordapp.com https://media.discordapp.net; connect-src 'self'"
    }

    handle /api/* {
        reverse_proxy api:8080 {
            header_up X-API-Key {$API_KEY}
        }
    }

    handle /files/* {
        reverse_proxy cdn:8091
    }

    handle /admin {
        redir /admin/ permanent
    }

    handle_path /admin/* {
        reverse_proxy admin:8081
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
